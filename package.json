{
  "name": "app-lab",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --config vite.production.config.mjs",
    "build:staging": "tsc -b && vite build --config vite.staging.config.mjs --outDir artifacts/staging",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "deploy:pages": "bash scripts/deploy-github-pages.sh",
    "experiment:ai": "set -a; [ ! -f .env.test.local ] || . ./.env.test.local; set +a; vite-node experiments/ai/run.ts",
    "experiment:ai:browser": "playwright test --config experiments/ai/playwright.config.ts",
    "preview": "vite preview --config vite.production.config.mjs --host 127.0.0.1",
    "check": "pnpm deps:check && pnpm test && pnpm build",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert '@firebase|@openrouter'",
    "test:pwa": "pnpm typecheck && playwright test --config playwright.pwa.config.ts",
    "test:firebase-e2e": "set -a; [ ! -f .env.test.local ] || . ./.env.test.local; set +a; node scripts/require-firebase-test-env.mjs && playwright test --grep @firebase",
    "test:firebase-smoke": "set -a; [ ! -f .env.test.local ] || . ./.env.test.local; set +a; node scripts/require-firebase-test-env.mjs && vitest run --config vitest.firebase-smoke.config.ts",
    "test:openrouter-e2e": "set -a; [ ! -f .env.test.local ] || . ./.env.test.local; set +a; node scripts/require-openrouter-test-env.mjs && playwright test --grep @openrouter",
    "typecheck": "tsc -b",
    "deps:check": "depcruise --config .dependency-cruiser.cjs --output-type err src",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs --include-only '^src' --exclude '\\.(?:test|spec)\\.(?:ts|tsx)$' --collapse '^src/[^/]+' --output-type mermaid --output-to dependency-graph.mmd src",
    "deps:graph:files": "depcruise --config .dependency-cruiser.cjs --include-only '^src' --exclude '\\.(?:test|spec)\\.(?:ts|tsx)$' --output-type mermaid --output-to dependency-file-graph.mmd src"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@tailwindcss/browser": "4.1.18",
    "alpinejs": "3.14.9",
    "eventsource-parser": "3.0.6",
    "firebase": "10.14.1",
    "lucide-react": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/react": "15.0.7",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-node": "2.1.8",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "2.1.8"
  }
}
