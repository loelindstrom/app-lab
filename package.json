{
  "name": "app-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "deploy:pages": "bash scripts/deploy-github-pages.sh",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "set -a; [ ! -f .env.test.local ] || . ./.env.test.local; set +a; playwright test",
    "test:firebase-smoke": "set -a; [ ! -f .env.test.local ] || . ./.env.test.local; set +a; vitest run src/sync/firebaseRealtimeProvider.smoke.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tailwindcss/browser": "4.1.18",
    "alpinejs": "3.14.9",
    "firebase": "10.14.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/react": "15.0.7",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
