# Firebase web app config used by auth-v1 Firebase smoke tests and Playwright E2E.
APP_LAB_FIREBASE_AUTH_V1_SMOKE_CONFIG='{"apiKey":"...","appId":"...","authDomain":"...","databaseURL":"https://your-project.region.firebasedatabase.app","projectId":"..."}'

# Required for auth-v1 Firebase rules. This must be the exact owner setup secret
# embedded in the RTDB rules generated by App Lab's first-time setup guide.
APP_LAB_FIREBASE_AUTH_V1_OWNER_SETUP_SECRET='app_lab_owner_...'

# OpenRouter API key used only by the opt-in paid integration test.
# The test owns its model choice so this file contains credentials only.
APP_LAB_OPENROUTER_TEST_API_KEY='sk-or-v1-...'
